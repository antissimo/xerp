# Copy to .env to override the dev defaults in compose.yaml.
POSTGRES_USER=xerp
POSTGRES_PASSWORD=xerp
POSTGRES_DB=xerp
XERP_API_PORT=8000
# Platform admin key (Authorization: Bearer <key>) for /api/v1/admin/*. At least 32 characters,
# e.g. `openssl rand -base64 32`. Left empty, admin routes reject every request.
XERP_ADMIN_KEY=
